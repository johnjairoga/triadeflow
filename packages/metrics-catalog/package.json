{
  "name": "@triadeflow/metrics-catalog",
  "version": "0.0.1",
  "description": "YAML-based metrics catalog + codegen for TriadeFlow Dashboard",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./load": "./src/load.ts",
    "./generate": "./src/generate-dbt-models.ts",
    "./schema": "./schema"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "validate": "node src/validate-catalog.ts"
  },
  "dependencies": {
    "yaml": "^2.3.0",
    "ajv": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
