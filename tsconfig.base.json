{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@triadeflow/db": ["packages/db/src"],
      "@triadeflow/db/*": ["packages/db/src/*"],
      "@triadeflow/metrics-catalog": ["packages/metrics-catalog/src"],
      "@triadeflow/metrics-catalog/*": ["packages/metrics-catalog/src/*"],
      "@triadeflow/modules-registry": ["packages/modules-registry/src"],
      "@triadeflow/modules-registry/*": ["packages/modules-registry/src/*"],
      "@triadeflow/theme": ["packages/theme/src"],
      "@triadeflow/theme/*": ["packages/theme/src/*"],
      "@triadeflow/config": ["packages/config/src"],
      "@triadeflow/config/*": ["packages/config/src/*"]
    }
  }
}
